+def seed_everything(seed):
+    """ Seed every RNG the pipeline touches (few-shot sampling, client split, prompt init). """
+    import random
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+
+
+class TestFeatureCache:
+    """ Precomputed image-encoder outputs for an evaluation loader.
+
+    The image encoder is frozen and the test transform is deterministic, so its outputs are
+    identical in every round. Caching them makes evaluation exact and much cheaper.
+    Batches (and therefore batch composition) are kept exactly as the loader produced them.
+    """
+
+    def __init__(self, model, dataloader, device, precision='amp'):
+        self.batches = []
+        with torch.no_grad():
+            for images, labels in dataloader:
+                images = images.to(device).type(model.dtype)
+                if precision == 'amp':
+                    with torch.cuda.amp.autocast():
+                        feats = model.image_encoder(images)
+                else:
+                    feats = model.image_encoder(images)
+                self.batches.append((feats.detach().cpu(), labels.clone()))
+        self.nbytes = sum(f.numel() * f.element_size() for f, _ in self.batches)
+
+    def __iter__(self):
+        return iter(self.batches)
+
+    def __len__(self):
+        return len(self.batches)
+
+
+def get_device(device_id=0):
+    """ CUDA device when available, CPU otherwise (CPU is only meant for smoke tests). """
+    if torch.cuda.is_available():
+        return torch.device('cuda', device_id)
+    return torch.device('cpu')
+
+
